# CoinMarketCap Pro API key (server-side only). Free Basic key works to start.
# Get one at https://pro.coinmarketcap.com/  — leave blank to use the keyless trial API.
CMC_API_KEY=

# CoinMarketCap AI Agent Hub (Data MCP). The same CMC key works as X-CMC-MCP-API-KEY.
# Leave CMC_MCP_API_KEY blank to reuse CMC_API_KEY. Endpoint defaults to the public Hub.
CMC_MCP_API_KEY=
CMC_MCP_ENDPOINT=

# Vercel KV (Upstash) — for the forward-test log. Auto-injected when you add KV in Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: generative rationale instead of the template version.
ANTHROPIC_API_KEY=

# Optional alerts — webhook fired on regime shifts / high-conviction signals.
# For Telegram: https://api.telegram.org/bot<token>/sendMessage  + ALERT_CHAT_ID.
ALERT_WEBHOOK_URL=
ALERT_CHAT_ID=
