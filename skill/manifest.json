  "data_dependencies": {
    "coinmarketcap": [
      "/v3/fear-and-greed/latest",
      "/v3/fear-and-greed/historical",
      "/v1/global-metrics/quotes/latest",
      "/v1/global-metrics/quotes/historical",
      "/v1/cryptocurrency/listings/latest",
      "/v2/cryptocurrency/ohlcv/historical",
      "/v2/cryptocurrency/quotes/latest",
      "agent-hub:get_global_metrics_latest",
      "agent-hub:get_global_crypto_derivatives_metrics"
    ]
  },
  "input_schema": {
    "type": "object",
    "required": [
      "asOf",
      "market",
      "coins"
    ],
    "properties": {
      "asOf": {
        "type": "string",
        "format": "date-time"
      },
      "market": {
        "type": "object",
        "required": [
          "fearGreed",
          "altseasonIndex",
          "btcDominance",
          "btcDominanceTrend",
          "btcReturn7d",
          "btcReturn30d"
        ],
        "properties": {
          "fearGreed": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "altseasonIndex": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "btcDominance": {
            "type": "number"
          },
          "btcDominanceTrend": {
            "type": "number",
            "description": "dominance slope over the lookback window (pct points)"
          },
          "btcReturn7d": {
            "type": "number"
          },
          "btcReturn30d": {
            "type": "number"
          },
          "etfNetFlowZ": {
            "type": "number",
            "description": "optional: z-score of 5d net ETF flow (live)"
          },
          "aggFundingRate": {
            "type": "number",
            "description": "optional: aggregate perp funding per 8h (live, derivatives)"
          },
          "openInterestChange": {
            "type": "number",
            "description": "optional: 24h change in total OI (live, derivatives)"
          },
          "liquidationCascade": {
            "type": "boolean"
          },
          "riskFlag": {
            "type": "boolean"
          }
        }
      },
      "coins": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "symbol",
            "name",
            "marketCap",
            "volume24h",
            "pctChange24h",
            "pctChange7d",
            "pctChange30d",
            "pctChange90d"
          ],
          "properties": {
            "symbol": {
              "type": "string"
            },
            "rsi": {
              "type": "number",
              "description": "optional: RSI(14) from OHLCV"
            },
            "macdHistogram": {
              "type": "number",
              "description": "optional: MACD histogram from OHLCV"
            },
            "fundingRate": {
              "type": "number"
            },
            "exchangeNetflow": {
              "type": "number"
            }
          }
        }
      },
      "prevRegime": {
        "type": "string"
      },
      "options": {
        "type": "object",
        "properties": {
          "fullScan": {
            "type": "boolean",
            "description": "scan the whole liquid market"
          },
          "topN": {
            "type": "number"
          },
          "confidenceScaling": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "asOf": {
        "type": "string"
      },
      "market": {
        "type": "object",
        "description": "regime, confidence, reasons, transition, tilts, risk flags"
      },
      "rankedCoins": {
        "type": "array",
        "description": "ranked directional signals with target weights + per-coin rationale"
      },
      "totalTargetExposure": {
        "type": "number"
      },
      "rationale": {
        "type": "string",
        "description": "natural-language explanation of the decision"
      }
    }
  },
  "entrypoint": "lib/skill.ts#evaluate",
  "endpoints": {
    "live": "GET /api/regime",
    "skills": "GET /api/skills",
    "backtest": "GET /api/backtest",
    "prices": "GET /api/prices",
    "sectors": "GET /api/sectors",
    "agent_hub": "GET /api/agenthub",
    "market_map": "GET /api/marketmap",
    "agent_hub_engine": "GET /api/agenthub-engine",
    "technical_analysis": "GET /api/ta",
    "skill": "GET /api/skill",
    "skill_describe": "GET /api/skill/describe",
    "x402_skill": "GET /api/x402/skill",
    "monte_carlo": "GET /api/montecarlo",
    "cmc100": "GET /api/cmc100",
    "mcp": "POST /api/mcp",
    "skill_backtest": "GET /api/skill-backtest",
    "narratives": "GET /api/narratives",
    "macro": "GET /api/macro",
    "news": "GET /api/news",
    "lookup": "GET /api/lookup",
    "consensus": "GET /api/consensus"
  },
  "data_source_primary": "CoinMarketCap AI Agent Hub (MCP) at https://mcp.coinmarketcap.com/mcp, with CMC REST + mock fallback; keyless x402 supported",
  "skillsMarketplace": {
    "ready": true,
    "discover": "GET /api/skill/describe",
    "invoke": "GET /api/skill",
    "auth": "none",
    "agentReadyOutput": true,
    "outputShape": "decision framework — regime + riskPosture + marketState + BTC/ETH BUY/SELL/HOLD + confirmingSignals + invalidation + netExposure + rationale",
    "formats": [
      "json",
      "md",
      "yaml"
    ],
    "decisionFramework": [
      "riskPosture",
      "marketState",
      "confirmingSignals",
      "invalidation",
      "dataFreshness"
    ]
  },
  "x402": {
    "endpoint": "GET /api/x402/skill",
    "version": 1,
    "network": "base",
    "asset": "USDC (0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913)",
    "pricePerCall": "0.01 USDC (example)",
    "note": "Reference x402 handshake; settlement verification via facilitator required in production."
  },
  "mcpServer": {
    "transport": "streamable-http",
    "endpoint": "/api/mcp",
    "protocol": "2024-11-05",
    "tools": [
      "get_strategy_decision",
      "describe_strategy",
      "scan_altcoins",
      "get_narrative_rotation",
      "get_macro_events",
      "coin_lookup",
      "skill_consensus"
    ]
  }
}